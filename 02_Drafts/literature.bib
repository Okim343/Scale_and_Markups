@article{SHANKS2024257,
title = {Increasing returns to scale and markups},
journal = {Structural Change and Economic Dynamics},
volume = {70},
pages = {257-267},
year = {2024},
issn = {0954-349X},
doi = {https://doi.org/10.1016/j.strueco.2024.02.009},
url = {https://www.sciencedirect.com/science/article/pii/S0954349X24000316},
author = {Olga Shanks},
keywords = {Market concentration, Markup, Elasticity of scale, Increasing returns to scale, Production function estimation},
abstract = {I estimate aggregate and industry-specific elasticities of scale and markups for the U.S. economy over the period from 1980 to 2019 using data on publicly traded companies. I apply Olley–Pakes and Ackerberg–Caves–Frazer estimation methods and find that the aggregate elasticity of scale for the U.S. economy is 1.1 and has been rising. The elasticity of scale in turn serves as an input for calculating industry markups. Increasing returns to scale help explain observed increases in markups over the last decades for broad sectors of the economy. My estimate of 1.2 for the aggregate markup is significantly lower than the estimate of 1.6 found in recent literature. The large disparity in markup estimates stems from differences in the treatment of fixed and variable costs and the methodological approach to the calculation of markups.}
}

